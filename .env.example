# Application URL used in generated receipt links
APP_URL="http://localhost:3000"

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/rajmudra_mandal_db?retryWrites=true&w=majority"

# Generate a long, random value for signing login sessions
JWT_SECRET="<replace-with-a-long-random-secret>"

# Used only when creating the first admin in an empty database
INITIAL_ADMIN_PHONE="<mobile-number>"
INITIAL_ADMIN_PASSWORD="<replace-with-a-strong-private-password>"
